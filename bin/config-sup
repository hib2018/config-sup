#!/bin/sh
set -eu

script=$0
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case "$link" in
    /*) script=$link ;;
    *) script=$(dirname "$script")/$link ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd -P)
if [ ! -d "$root/node_modules/@earendil-works/pi-coding-agent" ]; then
  printf 'config-sup: 依存関係がありません。%s で npm install を実行してください。\n' "$root" >&2
  exit 1
fi
cd "$root"
exec go run ./src "$@"
